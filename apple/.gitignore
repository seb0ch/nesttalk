fastlane/test_output/
build/

# Libbox binary artifact is not committed (~468MB).
# It's rebuilt from the pinned upstream commits in ThirdParty/libbox-version.txt
# via gomobile bind. During the v0.4.0 spike (Day 1), a scripts/build-libbox.sh
# will be written that regenerates ThirdParty/Libbox.xcframework from source.
ThirdParty/Libbox.xcframework/

