# Example values only. Normal first-time deployment generates deploy/.env via ./deploy/up.sh.
# Optional legacy direct-API fallback. Leave empty for REALITY-only deployments.
# API_BASE_URL=https://api.example.com
NESTTALK_DATA_DIR=/opt/nesttalk/data
TURN_SECRET=replace-with-random-secret
TURN_REALM=nesttalk
LISTEN_ADDR=127.0.0.1:8080
REALITY_SERVER_ADDR=vpn.example.com:443
REALITY_PUBLIC_KEY=replace-with-reality-public-key
REALITY_PRIVATE_KEY=replace-with-reality-private-key
REALITY_SHORT_ID=replace-with-reality-short-id
REALITY_API_UUID=replace-with-reality-api-uuid
REALITY_TURN_UUID=replace-with-reality-turn-uuid
REALITY_SNI=cloudflare.com
REALITY_DEST=cloudflare.com:443
API_REDIRECT=127.0.0.1:8080
# Per-request HTTP logging (metadata only). 1 = on (default), empty = off (release).
NESTTALK_DEBUG=1
# APNs VoIP push (incoming-call-while-closed). Leave KEY_ID/TEAM_ID empty to
# disable. The .p8 key is supplied OUT-OF-BAND as a podman secret, never here:
#   podman secret create nesttalk-apns-p8 deploy/.apns.p8
NESTTALK_APNS_KEY_ID=
NESTTALK_APNS_TEAM_ID=
NESTTALK_APNS_TOPIC_VOIP=com.nesttalk.ios.voip
NESTTALK_APNS_ENDPOINT=api.push.apple.com:443
