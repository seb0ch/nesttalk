# Multi-stage build for NestTalk server API
# Base: Alpine 3.23

FROM docker.io/library/golang:1.26.1-alpine3.23 AS builder

RUN apk add --no-cache gcc musl-dev sqlite-dev

WORKDIR /src
COPY server/go.mod server/go.sum ./
RUN go mod download

COPY server/ .
RUN CGO_ENABLED=1 go build -p=1 -o /nesttalk-api ./cmd/nesttalk-server/

# Runtime
FROM docker.io/library/alpine:3.23

RUN apk add --no-cache sqlite-libs ca-certificates
COPY --from=builder /nesttalk-api /usr/local/bin/nesttalk-api

RUN mkdir -p /data
ENV DB_PATH=/data/nesttalk.db
ENV LISTEN_ADDR=127.0.0.1:8080

ENTRYPOINT ["nesttalk-api"]
